<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="Content_Params" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="Content_Params.HomePage.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="Content_Params" widgetRefId="HomePage" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0300_LengthParameters" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="Content_Params.HomePage1.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="Content_Params" widgetRefId="HomePage1" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0320_IO_Force" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>