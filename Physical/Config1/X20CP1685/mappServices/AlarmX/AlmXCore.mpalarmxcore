<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<Configuration>
  <Element ID="gMpLink_AlarmXCore" Type="mpalarmxcore">
    <Group ID="mapp.Gen">
      <Property ID="Enable" Value="TRUE" />
      <Property ID="EnableCockpit" Value="TRUE" />
      <Property ID="TaskClass" Value="1" />
      <Property ID="Parent" />
    </Group>
    <Group ID="mapp.AlarmX.Core">
      <Group ID="Mapping">
        <Group ID="[0]">
          <Property ID="Alarm" Value="[0]" />
          <Selector ID="Action" Value="Reaction">
            <Property ID="Name" Value="Category0_Abort" />
          </Selector>
        </Group>
        <Group ID="[1]">
          <Property ID="Alarm" Value="[1]" />
          <Selector ID="Action" Value="Reaction">
            <Property ID="Name" Value="Category1_Stop" />
          </Selector>
        </Group>
        <Group ID="[2]">
          <Property ID="Alarm" Value="[2]" />
          <Selector ID="Action" Value="Reaction">
            <Property ID="Name" Value="Category2_Pause" />
          </Selector>
        </Group>
        <Group ID="[3]">
          <Property ID="Alarm" Value="[3]" />
          <Selector ID="Action" Value="Reaction">
            <Property ID="Name" Value="Category3_Info" />
          </Selector>
        </Group>
      </Group>
    </Group>
    <Group ID="mapp.AlarmX.List">
      <Group ID="[0]">
        <Property ID="List" Value="gMpLink_AlarmXList_Abort" />
        <Property ID="Offset" Value="0" />
      </Group>
      <Group ID="[1]">
        <Property ID="List" Value="gMpLink_AlarmXList_Stop" />
        <Property ID="Offset" Value="0" />
      </Group>
      <Group ID="[2]">
        <Property ID="List" Value="gMpLink_AlarmXList_Info" />
        <Property ID="Offset" Value="0" />
      </Group>
    </Group>
    <Selector ID="mapp.AlarmX.Create" Value="Disabled" />
    <Group ID="mapp.AlarmX.Core.Retain">
      <Selector ID="Memory" Value="0" />
    </Group>
    <Group ID="mapp.AlarmX.Core.Categories">
      <Group ID="[0]">
        <Property ID="List" Value="gMpLink_AlarmXCategory" />
      </Group>
    </Group>
  </Element>
</Configuration>