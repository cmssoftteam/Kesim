	ERR_DELTA_MIX_PRESSURE_TOO_LOW : UINT := 1023;
	ERR_M_MAT_IN_MIXER_TIME_1ST_WARN : UINT := 1024; (*Material in mixer is to long - Make Cleaning or Dossing*)
	ERR_M_MACHINE_MIXING : UINT := 1025; (*Material in mixer is to long - Make Cleaning or Dossing*)
END_VAR
