<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="content_AlarmXHistory" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="content_AlarmXHistory.Button_Export.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_AlarmXHistory" widgetRefId="Button_Export" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="$IAT/dialog_AlarmXMgr/MessageBox.AlarmXHistory.Export.Message" header="$IAT/dialog_AlarmXMgr/MessageBox.AlarmXHistory.Export.Header" icon="Question" />
          </Target>
          <Result>
            <ResultHandler condition="result = 4">
              <Action>
                <Target xsi:type="opcUa.NodeAction" refId="::AlarmX:Loc.FB.AlarmXHistory.Export">
                  <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
                </Target>
              </Action>
            </ResultHandler>
          </Result>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_AlarmXHistory.Button_Clear.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_AlarmXHistory" widgetRefId="Button_Clear" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="$IAT/dialog_AlarmXMgr/MessageBox.AlarmXHistory.Clear.Message" header="$IAT/dialog_AlarmXMgr/MessageBox.AlarmXHistory.Clear.Header" icon="Question" />
          </Target>
          <Result>
            <ResultHandler condition="result = 4">
              <Action>
                <Target xsi:type="opcUa.NodeAction" refId="::AlarmX:Loc.FB.AlarmXHistory.Clear">
                  <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
                </Target>
              </Action>
            </ResultHandler>
          </Result>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="EventBinding_AlarmXHistory_CommandDone">
      <Source xsi:type="opcUa.Event" refId="::AlarmX:Loc.FB.AlarmXHistory.CommandDone" event="ValueChanged" />
      <Operand datatype="BOOL" name="Operand_Export">
        <ReadTarget xsi:type="opcUa.NodeAction.Read" refId="::AlarmX:Loc.FB.AlarmXHistory.Export">
          <Method xsi:type="opcUa.NodeAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="newValue = TRUE AND Operand_Export = TRUE">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/dialog_AlarmXMgr/MessageBox.ExportSuccessful.Message" header="$IAT/dialog_AlarmXMgr/MessageBox.ExportSuccessful.Header" icon="Information" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler>
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::AlarmX:Loc.FB.AlarmXHistory.Export">
                <Method xsi:type="opcUa.NodeAction.SetValueBool" value="false" />
              </Target>
            </Action>
          </Step>
          <Step order="1">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::AlarmX:Loc.FB.AlarmXHistory.Clear">
                <Method xsi:type="opcUa.NodeAction.SetValueBool" value="false" />
              </Target>
            </Action>
          </Step>
          <Step order="2">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::AlarmX:Loc.Cmd.AutoExport">
                <Method xsi:type="opcUa.NodeAction.SetValueBool" value="false" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
    <EventBinding id="EventBinding_AlarmXHistory_CommandBusy">
      <Source xsi:type="opcUa.Event" refId="::AlarmX:Loc.FB.AlarmXHistory.CommandBusy" event="ValueChanged" />
      <EventHandler condition="newValue = TRUE">
        <Action>
          <Target xsi:type="widgets.brease.Image.Action" contentRefId="content_AlarmXHistory" widgetRefId="Image_InProgress">
            <Method xsi:type="widgets.brease.Image.Action.SetVisible" value="true" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="newValue = FALSE">
        <Action>
          <Target xsi:type="widgets.brease.Image.Action" contentRefId="content_AlarmXHistory" widgetRefId="Image_InProgress">
            <Method xsi:type="widgets.brease.Image.Action.SetVisible" value="false" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="EventBinding_AlarmXHistory_AutoExport">
      <Source xsi:type="opcUa.Event" refId="::AlarmX:Loc.Cmd.AutoExport" event="ValueChanged" />
      <EventHandler condition="newValue = TRUE">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/dialog_AlarmXMgr/MessageBox.AlarmXHistory.Export.Message" header="$IAT/dialog_AlarmXMgr/MessageBox.AlarmXHistory.Export.Header" icon="Information" />
          </Target>
          <Result>
            <ResultHandler condition="result = 4">
              <Action>
                <Target xsi:type="opcUa.NodeAction" refId="::AlarmX:Loc.FB.AlarmXHistory.Export">
                  <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
                </Target>
              </Action>
            </ResultHandler>
          </Result>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_AlarmXHistory.Button_Detail.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_AlarmXHistory" widgetRefId="Button_Detail" event="Click" />
      <Operand datatype="ANY_INT" name="Operand_SelectedAlarm_code">
        <ReadTarget xsi:type="session.VariableAction.Read" refId="SelectedAlarm_code">
          <Method xsi:type="session.VariableAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="Operand_SelectedAlarm_code = 0">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/dialog_AlarmXMgr/MessageBox.AlarmSelect.Message" header="$IAT/dialog_AlarmXMgr/MessageBox.AlarmSelect.Header" icon="Warning" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="Operand_SelectedAlarm_code &gt; 0">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_AlarmXDetail" headerText="$IAT/dialog_AlarmXDetail/Dialog.Header" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_AlarmXHistory.AlarmHistory_Table.ItemClick">
      <Source xsi:type="widgets.brease.AlarmHistory.Event" contentRefId="content_AlarmXHistory" widgetRefId="AlarmHistory_Table" event="ItemClick" />
      <EventHandler>
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="session.VariableAction" refId="SelectedAlarm_code">
                <Method xsi:type="session.VariableAction.SetValueNumber" value="=code" />
              </Target>
            </Action>
          </Step>
          <Step order="1">
            <Action>
              <Target xsi:type="session.VariableAction" refId="SelectedAlarm_name">
                <Method xsi:type="session.VariableAction.SetValueString" value="=name" />
              </Target>
            </Action>
          </Step>
          <Step order="2">
            <Action>
              <Target xsi:type="session.VariableAction" refId="SelectedAlarm_messsage">
                <Method xsi:type="session.VariableAction.SetValueString" value="=message" />
              </Target>
            </Action>
          </Step>
          <Step order="3">
            <Action>
              <Target xsi:type="session.VariableAction" refId="SelectedAlarm_timestamp">
                <Method xsi:type="session.VariableAction.SetValueString" value="=timestamp" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>
