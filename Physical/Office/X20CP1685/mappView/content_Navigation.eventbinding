<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="content_Navigation" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="content_Navigation.HomePage.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="HomePage" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0001_StartPage" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ManualPage.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ManualPage" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0100_Manual" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ToggleButton3.Click_1">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ToggleButton3" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_Params" horizontalPos="160px" verticalPos="120px" autoClose="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ToggleButton4.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ToggleButton4" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_Services" horizontalPos="160px" verticalPos="120px" autoClose="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>