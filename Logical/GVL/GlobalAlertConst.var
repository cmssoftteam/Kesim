(**)
VAR CONSTANT
	ERR_H_AXIS_IS_NOT_READY_TO_START : UINT := 900; (*Hydr. Axis is not ready to start*)
	ERR_H_SELECTED_UNIT_WRONG_VALUE : UINT := 901; (*Wrong value of selected hydraulic unit unit*)
	ERR_H_FIX_SPEED_IS_ZERO : UINT := 902; (*Fix pump speed is zero*)
	ERR_H_NO_DIR_CHANGE : UINT := 903; (*No change of pump move direction - check up and down sensors*)
	ERR_H_FILLING_TIME_LIMIT : UINT := 904; (*Filling - filling of A or B material is taking too long - check pressure sensors*)
	ERR_H_PUMP_SPEED_UP_TIME_LIMIT : UINT := 905; (*Speeding up pump is taking too long*)
	ERR_H_PUMP_REACH_PRES_TIME_LIMIT : UINT := 906; (*Reaching set pressure is taking too long*)
	ERR_H_NO_MATERIAL_WHILE_DOSSING : UINT := 907; (*During dosing system ran out of material*)
	ERR_H_FILL_CILI_NOT_DOWN_PRES_OK : UINT := 908; (*Filling pressure is reached, but hydraulic cilinder is not in down position*)
	ERR_H_PRESS_TOO_HIGH_A1 : UINT := 909; (*A1 component pressure is too high*)
	ERR_H_PRESS_TOO_HIGH_B1 : UINT := 910; (*B1 component pressure is too high*)
	ERR_H_PRESS_TOO_HIGH_A2 : UINT := 911; (*A2 component pressure is too high*)
	ERR_H_PRESS_TOO_HIGH_B2 : UINT := 912; (*B2 component pressure is too high*)
	ERR_H_PUMP_MOTOR_ERROR : UINT := 913; (*Hydraulic pump servo is in error*)
	ERR_MAT_EN_EX_IN_GLASS : UINT := 914; (*Material in mixer is too long - Make Cleaning or Dossing*)
END_VAR
