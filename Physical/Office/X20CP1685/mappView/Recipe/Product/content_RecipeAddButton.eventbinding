<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="content_RecipeAddButton" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="content_RecipeAddButton.Button_Ok.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeAddButton" widgetRefId="Button_Ok" event="Click" />
      <EventHandler>
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::RecipeProd:UIConnect.New.Create">
                <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
              </Target>
            </Action>
          </Step>
          <Step order="1">
            <Action>
              <Target xsi:type="clientSystem.Action">
                <Method xsi:type="clientSystem.Action.CloseDialog" dialogId="dialog_RecipeAdd" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeAddButton.Button_Cancel.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeAddButton" widgetRefId="Button_Cancel" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.CloseDialog" dialogId="dialog_RecipeAdd" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>