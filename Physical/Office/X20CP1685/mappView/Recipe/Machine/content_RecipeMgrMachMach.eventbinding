          <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:UIConnect.Recipe.List.PageUp">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_PageDown.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_PageDown" event="Click" />
