<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="content_RecipeMgrMachMach" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_Delete.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_Delete" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="$IAT/dialog_RecipeMgr/MessageBox.Delete.Message" header="$IAT/dialog_RecipeMgr/MessageBox.Delete.Header" icon="Question" />
          </Target>
          <Result>
            <ResultHandler condition="result=4">
              <Action>
                <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:UIConnect.Recipe.Delete">
                  <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
                </Target>
              </Action>
            </ResultHandler>
          </Result>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_Refresh.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_Refresh" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:UIConnect.Recipe.Refresh">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_Load.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_Load" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="$IAT/dialog_RecipeMgr/MessageBox.Load.Message" header="$IAT/dialog_RecipeMgr/MessageBox.Load.Header" icon="Question" />
          </Target>
          <Result>
            <ResultHandler condition="result=4">
              <Action>
                <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:Hmi.Cmd.Load">
                  <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
                </Target>
              </Action>
            </ResultHandler>
          </Result>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_Save.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_Save" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="$IAT/dialog_RecipeMgr/MessageBox.Save.Message" header="$IAT/dialog_RecipeMgr/MessageBox.Save.Header" icon="Question" />
          </Target>
          <Result>
            <ResultHandler condition="result=4">
              <Action>
                <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:Hmi.Cmd.Save">
                  <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
                </Target>
              </Action>
            </ResultHandler>
          </Result>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_Rename.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_Rename" event="Click" />
      <EventHandler>
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:UIConnect.Recipe.NewFileName">
                <Method xsi:type="opcUa.NodeAction.SetValueString" value="" />
              </Target>
            </Action>
          </Step>
          <Step order="1">
            <Action>
              <Target xsi:type="clientSystem.Action">
                <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_RecipeRenameMach" headerText="$IAT/dialog_RecipeRename/Dialog.Header" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_PageUp.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_PageUp" event="Click" />
      <EventHandler>
