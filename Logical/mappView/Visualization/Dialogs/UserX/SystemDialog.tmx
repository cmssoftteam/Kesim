    <note>Change the namespace to define where this text module should be located within the logical structure of your texts</note>
    <prop type="x-BR-TS:Namespace">IAT/System/Dialog</prop>
  </header>
  <body>
    <tu tuid="USERNAME">
      <tuv xml:lang="tr">
        <seg>kullanıcı adı</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>username</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Benutzer</seg>
      </tuv>
    </tu>
    <tu tuid="OLD_PASSWORD">
      <tuv xml:lang="tr">
        <seg>eski şifre</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>old password</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>altes Passwort</seg>
      </tuv>
    </tu>
    <tu tuid="NEW_PASSWORD">
      <tuv xml:lang="tr">
        <seg>yeni şifre</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>new password</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>neues Passwort</seg>
      </tuv>
    </tu>
    <tu tuid="CONFIRM_PASSWORD">
      <tuv xml:lang="tr">
        <seg>şifreyi onayla</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>confirm password</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwort wiederholen</seg>
      </tuv>
    </tu>
    <tu tuid="BTN_CHANGE_PASSWORD">
      <tuv xml:lang="tr">
        <seg>şifreyi değiştir</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>change password</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwort ändern</seg>
      </tuv>
    </tu>
    <tu tuid="BTN_CANCEL">
      <tuv xml:lang="tr">
        <seg>iptal</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>cancel</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Abbruch</seg>
      </tuv>
    </tu>
    <tu tuid="BTN_CONFIRM">
      <tuv xml:lang="tr">
        <seg>tamam</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>ok</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>ok</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_DIALOG_HEADER">
      <tuv xml:lang="tr">
        <seg>Şifre değiştir</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Change password</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwort ändern</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_DIALOG_FORCED_LOGIN_HEADER">
      <tuv xml:lang="tr">
        <seg>{1} için parola değişikliği gerekli</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Password change required for {1}</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwortänderung erforderlich für {1}</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_DIALOG_HEADER_USERNAME">
      <tuv xml:lang="tr">
        <seg>{1} için şifreyi değiştir</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Change password for {1}</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwort ändern für {1}</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_SUCCESS">
      <tuv xml:lang="tr">
        <seg>Şifre başarıyla değiştirildi!</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Password changed successfully!</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwortänderung erfolgreich!</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_FAIL">
      <tuv xml:lang="tr">
        <seg>Şifre değişikliği başarısız!</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Password change failed!</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwortänderung fehlgeschlagen!</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_INVALID_CREDENTIALS">
      <tuv xml:lang="tr">
        <seg>Geçersiz kimlik bilgileri (kullanıcı adı ve/veya eski şifre).</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Invalid credentials (username and/or old password).</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Anmeldedaten (Benutzer und/oder altes Passwort) nicht korrekt.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_POLICIES_NOT_MET">
      <tuv xml:lang="tr">
        <seg>Şifre, şifre politikalarına uymuyor.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Password does not meet the password policies.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwort entspricht nicht den Kriterien.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_SERVICE_NOTAVAILABLE">
      <tuv xml:lang="tr">
        <seg>Şifre değişikliği mümkün değil. Kimlik doğrulaması için RBAC yerine mpUserX kullanın.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Password change not possible. Use mpUserX instead of RBAC for authentication.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwortänderung nicht möglich. Verwenden Sie mpUserX anstatt RBAC zur Authentifizierung.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_TIMEOUT">
      <tuv xml:lang="tr">
        <seg>Zaman aşımı.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Timeout.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Zeitüberschreitung.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_UNKNOWN_ERROR">
      <tuv xml:lang="tr">
        <seg>Bilinmeyen bir hata oluştu.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>An unknown error has occurred.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Ein unbekannter Fehler ist aufgetreten.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_USERNAME_EMPTY">
      <tuv xml:lang="tr">
        <seg>Kullanıcı adı boş bırakılamaz.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Username must not be empty.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Benutzer darf nicht leer sein.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_OLDPASSWORD_EMPTY">
      <tuv xml:lang="tr">
        <seg>Eski şifre boş olamaz.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Old password must not be empty.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Altes Passwort darf nicht leer sein.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_NEWPASSWORD_EMPTY">
      <tuv xml:lang="tr">
        <seg>Yeni şifre boş bırakılamaz.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>New password must not be empty.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Neues Passwort darf nicht leer sein.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_NEWPASSWORD_NOTEQUAL_OLD">
      <tuv xml:lang="tr">
        <seg>Yeni şifreniz eski şifrenizden farklı olmalıdır.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>New password must be different from the old password.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Neues Passwort muss sich vom alten Passwort unterscheiden.</seg>
      </tuv>
    </tu>
    <tu tuid="CHANGEPASSWORD_PASSWORDS_DIFFERENT">
      <tuv xml:lang="tr">
        <seg>Şifre onayı yeni şifreyle uyuşmuyor.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Password confirmation does not match the new password.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Passwortwiederholung stimmt nicht dem neuen Passwort überein.</seg>
      </tuv>
    </tu>
    <tu tuid="DIALOG_CLOSES">
      <tuv xml:lang="tr">
        <seg>İletişim kutusu {1} saniye içinde kapatılacak.</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Dialog will be closed in {1} seconds.</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Dialog wird in {1} Sekunden geschlossen.</seg>
      </tuv>
    </tu>
    <tu tuid="POLICY_HEADER">
      <tuv xml:lang="tr">
        <seg>Şifreniz şu şekilde olmalıdır:</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Your password must have</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Das Passwort muss enthalten</seg>
      </tuv>
    </tu>
    <tu tuid="POLICY_DESC_ALPHANUMERIC">
      <tuv xml:lang="tr">
        <seg>Alfanümerik ve sayısal karakterler</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Alphanumeric and numeric characters</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Mindestens einen Buchstaben und eine Zahl</seg>
      </tuv>
    </tu>
    <tu tuid="POLICY_DESC_MIXEDCASE">
      <tuv xml:lang="tr">
        <seg>Büyük ve küçük harf karakterleri</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>Upper- and lowercase characters</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Groß- und Kleinbuchstaben</seg>
      </tuv>
    </tu>
    <tu tuid="POLICY_DESC_MINLENGTH">
      <tuv xml:lang="tr">
        <seg>{1} veya daha fazla karakter</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>{1} or more characters</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>{1} oder mehr Zeichen</seg>
      </tuv>
    </tu>
    <tu tuid="POLICY_DESC_SPECIALCHAR">
      <tuv xml:lang="tr">
        <seg>En az bir özel karakter (örn. $%ö)</seg>
      </tuv>
      <tuv xml:lang="en">
        <seg>At least one special character (e.g. $%ö)</seg>
      </tuv>
      <tuv xml:lang="de">
        <seg>Mindestens ein Sonderzeichen (z.B. %$ö)</seg>
      </tuv>
    </tu>
  </body>
</tmx>