VAR
	gHMI : gHMI_typ;
	gAlert : gAlertType;
	FirstVariable : USINT;
END_VAR
(*HW Modules*)
VAR CONSTANT
	NUMBER_OF_MODULES : USINT := 12; (*Number of forceable I/O modules in the HW configuration*)
	NUMBER_OF_MODULES_MINUS_ONE : USINT := NUMBER_OF_MODULES-1; (*Number of forceable I/O modules in the HW configuration*)
	MAX_IO_MODULE_NUM : USINT := 14; (*Total number of IO modules currently in the machine*)
	MAX_IO_MODULE_NUM_MINUS_ONE : USINT := MAX_IO_MODULE_NUM-1; (*Total number of IO modules currently in the machine minus 1*)
END_VAR
(*
-----------------------------------------------------------------------------------------------------
IO Forcing
----------------------------------------------------------------------------------------------------*)
VAR CONSTANT
	NUMBER_OF_IO_MODULES : USINT := 17; (*Number of forceable I/O modules in the HW configuration*)
	NUMBER_OF_IO_MODULES_MINUS_1 : USINT := NUMBER_OF_IO_MODULES - 1; (*Number of forceable I/O modules in the HW configuration*)
	TOTAL_NUM_OF_ALL_MODULE : USINT := 17; (*Total number of modules currently in the machine (for chceking module status - X20 cards, IF modulex ...)*)
	TOTAL_NUM_OF_ALL_MODULE_MINUS_1 : USINT := TOTAL_NUM_OF_ALL_MODULE- 1; (*Total number of IO modules currently in the machine minus 1 (for chceking module status - X20 cards, IF modulex ...)*)
	IO_START_INDEX_SELECTED_SLOT : ARRAY[0..NUMBER_OF_IO_MODULES_MINUS_1] OF INT := [0,20,40,60,80,100,120,140,160,180,185,190,195,200,205,210,215]; (*Name of IO channel's start index in the text group "IO_Chanel_names"*)
END_VAR
