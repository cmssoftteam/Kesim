(*========================================================================================================*)
(*Cutting table parameters structure*)
(*========================================================================================================*)
VAR RETAIN
	gOldOffset : REAL := 0.0; (*Previous homing offset for th C axis*)
	gParameters : gParameters_type; (*Cutting table parametesr structure*)
	gTotalCounter : UDINT; (*Total counter variable*)
	gDailyCounter : UDINT; (*Daily counter variable*)
	gSpeedRate : REAL; (*Speed rate variable*)
	gPressureRate : REAL; (*Pressure variable*)
	gDay : DATE; (*Variable with day information*)
	gMaxWorkCycles : UDINT; (*Maximum number of cycles until the machine is locked*)
END_VAR
VAR
	gFactorySettings : gParameters_type; (*Structure with the factory settings*)
END_VAR
