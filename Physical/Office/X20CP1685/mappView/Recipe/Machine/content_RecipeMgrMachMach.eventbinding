          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_RecipeMgrMach.Button_Recipe_StepUp.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_StepUp" event="Click" />
      <EventHandler>
