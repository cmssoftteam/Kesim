<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="6.0"?>
<OpcUaSource FileVersion="10">
  <Aliases>
    <ACLAliases />
    <EURangeViolationAliases />
    <EURangesAliases />
    <EngineeringUnitAliases />
  </Aliases>
  <Module Name="&lt;Default&gt;">
    <Task Name="AlarmX">
      <Variable Name="Loc">
        <Variable Name="FB">
          <Variable Name="AlarmXHistory">
            <Variable Name="Export" />
            <Variable Name="Clear" />
            <Variable Name="CommandBusy" />
            <Variable Name="CommandDone" />
          </Variable>
          <Variable Name="AlarmXCore">
            <Variable Name="ActiveAlarms" />
            <Variable Name="PendingAlarms" />
          </Variable>
        </Variable>
        <Variable Name="Cmd">
          <Variable Name="AutoExport" />
        </Variable>
        <Variable Name="Status">
          <Variable Name="ReactionCategory" RecursiveEnable="2" />
        </Variable>
      </Variable>
    </Task>
  </Module>
</OpcUaSource>