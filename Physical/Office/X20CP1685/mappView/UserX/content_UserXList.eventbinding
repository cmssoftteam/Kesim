<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="content_UserXList" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Bindings>
		<EventBinding id="content_UserXList.Button_Edit.Click">
			<Source xsi:type="widgets.brease.Button.Event" contentRefId="content_UserXList" widgetRefId="Button_Edit" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="widgets.brease.UserList.Action" contentRefId="content_UserXList" widgetRefId="UserList_Table">
						<Method xsi:type="widgets.brease.UserList.Action.OpenModifyUserDialog" />
					</Target>
					<Result>
						<ResultHandler condition="result = 200">
							<Action>
								<Target xsi:type="clientSystem.Action">
									<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/modifyuser.USER_DOES_NOT_EXIST" header="$IAT/Widgets/UserList/modifyuser.TITLE" icon="Error" />
								</Target>
							</Action>
						</ResultHandler>
						<ResultHandler condition="result = 202">
							<Action>
								<Target xsi:type="clientSystem.Action">
									<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/modifyuser.INSUFFICIENT_RIGHTS" header="$IAT/Widgets/UserList/modifyuser.TITLE" icon="Error" />
								</Target>
							</Action>
						</ResultHandler>
						<ResultHandler condition="result = 206">
							<Action>
								<Target xsi:type="clientSystem.Action">
									<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/modifyuser.ACTION_NOT_PERMITTED" header="$IAT/Widgets/UserList/modifyuser.TITLE" icon="Error" />
								</Target>
							</Action>
						</ResultHandler>
					</Result>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.Button_Add.Click">
			<Source xsi:type="widgets.brease.Button.Event" contentRefId="content_UserXList" widgetRefId="Button_Add" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="widgets.brease.UserList.Action" contentRefId="content_UserXList" widgetRefId="UserList_Table">
						<Method xsi:type="widgets.brease.UserList.Action.OpenAddUserDialog" />
					</Target>
					<Result>
						<ResultHandler condition="result = 202">
							<Action>
								<Target xsi:type="clientSystem.Action">
									<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/adduser.INSUFFICIENT_RIGHTS" header="$IAT/Widgets/UserList/adduser.TITLE" icon="Error" />
								</Target>
							</Action>
						</ResultHandler>
					</Result>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.Button_Delete.Click">
			<Source xsi:type="widgets.brease.Button.Event" contentRefId="content_UserXList" widgetRefId="Button_Delete" event="Click" />
			<Operand datatype="ANY_STRING" name="mySelectedUser">
				<ReadTarget xsi:type="session.VariableAction.Read" refId="SelectedUserNameMsg">
					<Method xsi:type="session.VariableAction.GetValue" />
				</ReadTarget>
			</Operand>
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="=mySelectedUser" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Question" />
					</Target>
					<Result>
						<ResultHandler condition="result = 4">
							<Action>
								<Target xsi:type="widgets.brease.UserList.Action" contentRefId="content_UserXList" widgetRefId="UserList_Table">
									<Method xsi:type="widgets.brease.UserList.Action.DeleteUser" />
								</Target>
								<Result>
									<ResultHandler condition="result = 1">
										<Action>
											<Target xsi:type="clientSystem.Action">
												<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/deleteuser.SUCCESS" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Information" />
											</Target>
										</Action>
									</ResultHandler>
									<ResultHandler condition="result = 104">
										<Action>
											<Target xsi:type="clientSystem.Action">
												<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/deleteuser.SESSION_NOT_VALID" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Error" />
											</Target>
										</Action>
									</ResultHandler>
									<ResultHandler condition="result = 200">
										<Action>
											<Target xsi:type="clientSystem.Action">
												<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/deleteuser.USER_DOES_NOT_EXIST" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Error" />
											</Target>
										</Action>
									</ResultHandler>
									<ResultHandler condition="result = 202">
										<Action>
											<Target xsi:type="clientSystem.Action">
												<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/deleteuser.INSUFFICIENT_RIGHTS" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Error" />
											</Target>
										</Action>
									</ResultHandler>
									<ResultHandler condition="result = 207">
										<Action>
											<Target xsi:type="clientSystem.Action">
												<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/deleteuser.CURRENTLY_LOGGED_IN" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Error" />
											</Target>
										</Action>
									</ResultHandler>
									<ResultHandler condition="result = -3">
										<Action>
											<Target xsi:type="clientSystem.Action">
												<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/Widgets/UserList/deleteuser.CANNOT_DELETE_ANONYMOUS" header="$IAT/Widgets/UserList/deleteuser.TITLE" icon="Error" />
											</Target>
										</Action>
									</ResultHandler>
								</Result>
							</Action>
						</ResultHandler>
					</Result>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.Button_Export.Click">
			<Source xsi:type="widgets.brease.Button.Event" contentRefId="content_UserXList" widgetRefId="Button_Export" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Export.ShowDialog">
						<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
					</Target>
				</Action>
			</EventHandler>
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_UserXExport" headerText="$IAT/dialog_UserXExport/Dialog.Header" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.Button_Import.Click">
			<Source xsi:type="widgets.brease.Button.Event" contentRefId="content_UserXList" widgetRefId="Button_Import" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Import.ShowDialog">
						<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
					</Target>
				</Action>
			</EventHandler>
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_UserXImport" headerText="$IAT/dialog_UserXImport/Dialog.Header" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.Button_Refresh.Click">
			<Source xsi:type="widgets.brease.Button.Event" contentRefId="content_UserXList" widgetRefId="Button_Refresh" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="session.VariableAction" refId="UserXRefreshList">
						<Method xsi:type="session.VariableAction.SetValueBool" value="true" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="EventBinding_UserXListRefresh">
			<Source xsi:type="session.Event" refId="UserXRefreshList" event="ValueChanged" />
			<EventHandler condition="newValue = TRUE">
				<Sequence>
					<Step order="0">
						<Action>
							<Target xsi:type="session.VariableAction" refId="UserXRefreshList">
								<Method xsi:type="session.VariableAction.SetValueBool" value="false" />
							</Target>
						</Action>
					</Step>
					<Step order="1">
						<Action>
							<Target xsi:type="widgets.brease.ContentControl.Action" contentRefId="content_UserXMgr" widgetRefId="ContentControl_UserXList">
								<Method xsi:type="widgets.brease.ContentControl.Action.UnloadContent" />
							</Target>
						</Action>
					</Step>
					<Step order="2">
						<Action>
							<Target xsi:type="widgets.brease.ContentControl.Action" contentRefId="content_UserXMgr" widgetRefId="ContentControl_UserXList">
								<Method xsi:type="widgets.brease.ContentControl.Action.LoadContent" contentId="content_UserXList" />
							</Target>
						</Action>
					</Step>
				</Sequence>
			</EventHandler>
		</EventBinding>
		<EventBinding id="EventBinding_PasswordChangeRequired">
			<Source xsi:type="clientSystem.Event" event="PasswordChangeRequired" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.OpenChangePasswordDialog" userName="=userName" showPolicy="true" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.UserList_Table.ItemClick">
			<Source xsi:type="widgets.brease.UserList.Event" contentRefId="content_UserXList" widgetRefId="UserList_Table" event="ItemClick" />
			<EventHandler>
				<Sequence>
					<Step order="0">
						<Action>
							<Target xsi:type="session.VariableAction" refId="SelectedUserName">
								<Method xsi:type="session.VariableAction.SetValueString" value="=UserName" />
							</Target>
						</Action>
					</Step>
					<Step order="1">
						<Action>
							<Target xsi:type="session.VariableAction" refId="Login_UserName">
								<Method xsi:type="session.VariableAction.SetValueString" value="=UserName" />
							</Target>
						</Action>
					</Step>
				</Sequence>
			</EventHandler>
		</EventBinding>
		<EventBinding id="EventBinding_dialog_UserXError">
			<Source xsi:type="opcUa.Event" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.MessageBox.LayerStatus" event="ValueChanged" />
			<Operand datatype="BOOL" name="Status">
				<ReadTarget xsi:type="session.VariableAction.Read" refId="UserXErrorDialogOpen">
					<Method xsi:type="session.VariableAction.GetValue" />
				</ReadTarget>
			</Operand>
			<EventHandler condition="newValue = 0">
				<Sequence>
					<Step order="0">
						<Action>
							<Target xsi:type="clientSystem.Action">
								<Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_UserXError" headerText="$IAT/dialog_UserXError/Dialog.Header" />
							</Target>
						</Action>
					</Step>
					<Step order="1">
						<Action>
							<Target xsi:type="session.VariableAction" refId="UserXErrorDialogOpen">
								<Method xsi:type="session.VariableAction.SetValueBool" value="true" />
							</Target>
						</Action>
					</Step>
					<Step order="2">
						<Action>
							<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Import.Dialog.Cancel">
								<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
							</Target>
						</Action>
					</Step>
					<Step order="3">
						<Action>
							<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Export.Dialog.Cancel">
								<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
							</Target>
						</Action>
					</Step>
				</Sequence>
			</EventHandler>
			<EventHandler condition="newValue = 1 AND Status = TRUE">
				<Sequence>
					<Step order="0">
						<Action>
							<Target xsi:type="clientSystem.Action">
								<Method xsi:type="clientSystem.Action.CloseDialog" dialogId="dialog_UserXError" />
							</Target>
						</Action>
					</Step>
					<Step order="1">
						<Action>
							<Target xsi:type="session.VariableAction" refId="UserXErrorDialogOpen">
								<Method xsi:type="session.VariableAction.SetValueBool" value="false" />
							</Target>
						</Action>
					</Step>
					<Step order="2">
						<Action>
							<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Import.Dialog.Cancel">
								<Method xsi:type="opcUa.NodeAction.SetValueBool" value="false" />
							</Target>
						</Action>
					</Step>
					<Step order="3">
						<Action>
							<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Export.Dialog.Cancel">
								<Method xsi:type="opcUa.NodeAction.SetValueBool" value="false" />
							</Target>
						</Action>
					</Step>
				</Sequence>
			</EventHandler>
		</EventBinding>
		<EventBinding id="EventBinding_LoggedOut">
			<Source xsi:type="clientSystem.Event" event="LoggedOut" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/dialog_UserXMgr/MessageBox.AutoLogout.Message" header="$IAT/dialog_UserXMgr/MessageBox.AutoLogout.Header" icon="Information" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="EventBinding_UserXFileDuplicate" comment="Displays warning about duplicate file">
			<Source xsi:type="opcUa.Event" refId="::UserXMgr:Loc.Status.FileDuplicate" event="ValueChanged" />
			<EventHandler condition="newValue = TRUE">
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OKCancel" message="$IAT/dialog_UserXMgr/MessageBox.FileOverwrite.Message" header="$IAT/dialog_UserXMgr/MessageBox.FileOverwrite.Header" icon="Question" />
					</Target>
					<Result>
						<ResultHandler condition="result = 4">
							<Action>
								<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Cmd.ConfirmOverwrite">
									<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
								</Target>
							</Action>
						</ResultHandler>
						<ResultHandler condition="result = 8">
							<Action>
								<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Par.UserXMgrUIConnect.Export.Dialog.Cancel">
									<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
								</Target>
							</Action>
						</ResultHandler>
					</Result>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="EventBinding_ExportComplete">
			<Source xsi:type="opcUa.Event" refId="::UserXMgr:Loc.Status.ExportComplete" event="ValueChanged" />
			<EventHandler condition="newValue = TRUE">
				<Sequence>
					<Step order="0">
						<Action>
							<Target xsi:type="opcUa.NodeAction" refId="::UserXMgr:Loc.Status.UserExportDisplayed">
								<Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
							</Target>
						</Action>
					</Step>
					<Step order="1">
						<Action>
							<Target xsi:type="clientSystem.Action">
								<Method xsi:type="clientSystem.Action.ShowMessageBox" type="OK" message="$IAT/dialog_UserXExport/MessageBox.Export.Message" header="$IAT/dialog_UserXExport/MessageBox.Export.Header" icon="Information" />
							</Target>
						</Action>
					</Step>
				</Sequence>
			</EventHandler>
		</EventBinding>
		<EventBinding id="content_UserXList.Login_Button.MouseUp">
			<Source xsi:type="widgets.brease.LoginButton.Event" contentRefId="content_UserXList" widgetRefId="Login_Button" event="MouseUp" />
			<EventHandler>
				<Sequence>
					<Step order="0">
						<Action>
							<Target xsi:type="session.VariableAction" refId="Login_UserName">
								<Method xsi:type="session.VariableAction.SetValueString" value="" />
							</Target>
						</Action>
					</Step>
					<Step order="1">
						<Action>
							<Target xsi:type="session.VariableAction" refId="Login_Password">
								<Method xsi:type="session.VariableAction.SetValueString" value="" />
							</Target>
						</Action>
					</Step>
				</Sequence>
			</EventHandler>
		</EventBinding>
	</Bindings>
</EventBindingSet>
