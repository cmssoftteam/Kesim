      </Group>
      <Selector ID="Velocity">
        <Property ID="Velocity" Value="500000.0" />
      </Selector>
      <Selector ID="Acceleration">
        <Property ID="Acceleration" Value="500000.0" />
      </Selector>
      <Selector ID="Deceleration">
        <Property ID="Deceleration" Value="500000.0" />
      </Selector>
    </Selector>
    <Selector ID="Alarms" Value="None" />
  </Element>
