<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<Configuration>
  <Element ID="gMpLink_AxisQX" Type="axis">
    <Selector ID="BaseType" Value="LinearBounded" />

