<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="content_Navigation" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="EventBinding_1">
      <Source xsi:type="clientSystem.Event" event="ContentLoaded" />
      <Operand datatype="ANY_STRING" name="actUserName">
        <ReadTarget xsi:type="session.VariableAction.Read" refId="::SYSTEM:clientInfo.userId">
          <Method xsi:type="session.VariableAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="contentId=&quot;P0001_StartPage&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0001_StartPage" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0100_Manual&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0100_Manual" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0200_HW_Config&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0200_HW_Config" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0210_SDM&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0210_SDM" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0220_Cockpit&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0220_Cockpit" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0300_LengthParameters&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0300_LengthParameters" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0310_MotorSetups&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0310_MotorSetups" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0320_IO_Force&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0320_IO_Force" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0330_MachineSetup&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0330_MachineSetup" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0330_MachineSetup&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0330_MachineSetup" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0400_SystemInformation&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0400_SystemInformation" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0410_CompanyInformation&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0410_CompanyInformation" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;P0500_Widget&quot;">
        <Action>
          <Target xsi:type="session.VariableAction" refId="LoadedContent">
            <Method xsi:type="session.VariableAction.SetValueString" value="P0500_Widget" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="contentId=&quot;content_UserXMgr&quot;">
        <Action>
          <Target xsi:type="session.TimerAction" refId="TimerUserCheck">
            <Method xsi:type="session.TimerAction.Start" interval="100" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="actUserName=&quot;&quot;">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.Login" userName="anonymous" password="123" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::AsGlobalPV:gHMI.UserName">
            <Method xsi:type="opcUa.NodeAction.SetValueString" value="=actUserName" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.HomePage.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="HomePage" event="Click" />
      <Operand datatype="ANY_STRING" name="actLoadedContent">
        <ReadTarget xsi:type="session.VariableAction.Read" refId="LoadedContent">
          <Method xsi:type="session.VariableAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="actLoadedContent&lt;&gt;&quot;P0001_StartPage&quot;">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0001_StartPage" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ManualPage.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ManualPage" event="Click" />
      <Operand datatype="ANY_STRING" name="actLoadedContent">
        <ReadTarget xsi:type="session.VariableAction.Read" refId="LoadedContent">
          <Method xsi:type="session.VariableAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="actLoadedContent&lt;&gt;&quot;P0100_Manual&quot;">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0100_Manual" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ToggleButton3.Click_1">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ToggleButton3" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_Params" horizontalPos="160px" verticalPos="120px" autoClose="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ToggleButton4.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ToggleButton4" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_Services" horizontalPos="160px" verticalPos="120px" autoClose="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="content_Navigation.ToggleButton5.Click">
      <Source xsi:type="widgets.brease.ToggleButton.Event" contentRefId="content_Navigation" widgetRefId="ToggleButton5" event="Click" />
      <Operand datatype="ANY_STRING" name="actLoadedContent">
        <ReadTarget xsi:type="session.VariableAction.Read" refId="LoadedContent">
          <Method xsi:type="session.VariableAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="actLoadedContent&lt;&gt;&quot;P0410_CompanyInformation&quot;">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.LoadContentInArea" contentId="P0410_CompanyInformation" areaId="areaContent" pageId="page_Main" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>