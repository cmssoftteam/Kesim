    <EventBinding id="content_RecipeMgrMach.Button_Recipe_Add.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="content_RecipeMgrMach" widgetRefId="Button_Recipe_Add" event="Click" />
      <EventHandler>
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::RecipeMach:UIConnect.New.FileName">
                <Method xsi:type="opcUa.NodeAction.SetValueString" value="" />
              </Target>
            </Action>
          </Step>
          <Step order="1">
            <Action>
              <Target xsi:type="clientSystem.Action">
                <Method xsi:type="clientSystem.Action.OpenDialog" dialogId="dialog_RecipeAddMach" headerText="$IAT/dialog_RecipeAdd/Dialog.Header" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>